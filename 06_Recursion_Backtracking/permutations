class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> perms = new ArrayList<>();
        boolean[] used = new boolean[nums.length];
        backtrack(nums , used , new ArrayList<>() , perms);
        return perms;
    }
    private void backtrack(int[] nums, boolean[] used , List<Integer> perm ,List<List<Integer>> perms){
        if(perm.size() == nums.length){
            perms.add(new ArrayList<>(perm));
            return;
        }
        for(int i = 0;i < nums.length;i++){
            if(used[i]) continue;
            used[i] = true;
            perm.add(nums[i]);
            backtrack(nums , used , perm , perms);
            perm.remove(perm.size() - 1);
            used[i] = false;
        }
    }
}
