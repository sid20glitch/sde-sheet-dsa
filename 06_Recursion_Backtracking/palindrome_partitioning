class Solution {
    public List<List<String>> partition(String s) {
        int n = s.length();
        boolean[][] dp = new boolean[n][n];
        for(int i = n - 1; i >= 0; i--){
            for(int j = i; j < n;j++){
                if(s.charAt(i) == s.charAt(j)){
                    if(j - i <= 2){
                        dp[i][j] = true;
                    }else{
                        dp[i][j] = dp[i + 1][j - 1];
                    }
                }
            }
        }
        List<List<String>> result = new ArrayList<>();
        dfs(s , 0 , dp , new ArrayList<>() , result);
        return result;
    }
    private void dfs(String s , int start , boolean[][] dp , List<String> comb , List<List<String>> result){
        if(start == s.length()) {
            result.add(new ArrayList<>(comb));
            return;
        }
        for(int end = start; end < s.length(); end++){
            if(dp[start][end]){
                comb.add(s.substring(start , end + 1));
                dfs(s , end + 1 , dp ,comb , result);
                comb.remove(comb.size() - 1);
            }
        }
    }

    
}
